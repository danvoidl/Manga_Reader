# Base URL da API GraphQL (servidor Apollo em api/, porta 4000).
# Aparelho físico: use o IP da sua máquina na rede local (não "localhost").
# Emulador Android: http://10.0.2.2:4000  |  iOS sim / web: http://localhost:4000
EXPO_PUBLIC_API_URL=http://192.168.68.105:4000

# Auth MangaDex (client-side, direto no device). Default já é este valor.
EXPO_PUBLIC_MANGADEX_AUTH_URL=https://auth.mangadex.org/realms/mangadex/protocol/openid-connect/token
EXPO_PUBLIC_COVER_API_URL=https://uploads.mangadex.org/covers